{
  "uid": "pipeline",
  "title": "Invoice pipeline",
  "description": "Six panels, in the order a document travels: written, posted, received, read off its text, read off a scan, filed.",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-30m", "to": "now"},
  "editable": true,
  "graphTooltip": 1,
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [

    {
      "id": 1,
      "type": "timeseries",
      "title": "1. Invoices written, by kind",
      "description": "Every page the simulation draws, split by what it is: goods, freight, credit, customs, broker, storage, local.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "legendFormat": "{{kind}}",
         "expr": "sum by (kind) (increase(documents_by_kind_total[5m]))"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": {
            "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 75,
            "stacking": {"mode": "normal", "group": "A"},
            "showPoints": "never", "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },

    {
      "id": 2,
      "type": "timeseries",
      "title": "2. Mail sent",
      "description": "Invoices put into the mailbox, and how long the posting step takes.",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "legendFormat": "posted per minute",
         "expr": "sum(rate(invoices_total{stage=\"mailed\"}[5m])) * 60"},
        {"refId": "B", "legendFormat": "seconds per batch, 95th",
         "expr": "histogram_quantile(0.95, sum by (le) (rate(stage_seconds_bucket{stage=\"mail\"}[5m])))"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": {
            "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10,
            "showPoints": "never", "spanNulls": true,
            "gradientMode": "opacity", "axisBorderShow": false
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "posted per minute"},
           "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#5FC4EE"}}]},
          {"matcher": {"id": "byName", "options": "seconds per batch, 95th"},
           "properties": [
             {"id": "color", "value": {"mode": "fixed", "fixedColor": "#C9A227"}},
             {"id": "custom.fillOpacity", "value": 0}
           ]}
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },

    {
      "id": 3,
      "type": "timeseries",
      "title": "3. Mail received",
      "description": "Messages opened, and the backlog of messages posted but not yet opened.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "legendFormat": "opened per minute",
         "expr": "sum(rate(invoices_total{stage=\"read\"}[5m])) * 60"},
        {"refId": "B", "legendFormat": "waiting in the mailbox",
         "expr": "sum(invoices_total{stage=\"mailed\"}) - sum(invoices_total{stage=\"read\"})"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": {
            "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10,
            "showPoints": "never", "spanNulls": true,
            "gradientMode": "opacity", "axisBorderShow": false
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "opened per minute"},
           "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#2E9E6B"}}]},
          {"matcher": {"id": "byName", "options": "waiting in the mailbox"},
           "properties": [
             {"id": "color", "value": {"mode": "fixed", "fixedColor": "#D1495B"}},
             {"id": "custom.fillOpacity", "value": 0}
           ]}
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },

    {
      "id": 4,
      "type": "timeseries",
      "title": "4. PDFs read off their own text",
      "description": "Pages that carried a text layer, so nothing had to be guessed, and the seconds the read step spent.",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "legendFormat": "read from text, per 5 min",
         "expr": "sum(increase(documents_read_total{method=\"text\"}[5m]))"},
        {"refId": "B", "legendFormat": "seconds to read, 95th",
         "expr": "histogram_quantile(0.95, sum by (le) (rate(stage_seconds_bucket{stage=\"read\"}[5m])))"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": {
            "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10,
            "showPoints": "never", "spanNulls": true,
            "gradientMode": "opacity", "axisBorderShow": false
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "read from text, per 5 min"},
           "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#5FC4EE"}}]},
          {"matcher": {"id": "byName", "options": "seconds to read, 95th"},
           "properties": [
             {"id": "color", "value": {"mode": "fixed", "fixedColor": "#C9A227"}},
             {"id": "custom.fillOpacity", "value": 0}
           ]}
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },

    {
      "id": 5,
      "type": "timeseries",
      "title": "5. Scanned PDFs, read by OCR",
      "description": "Pages with no text layer, and how many readings a person still has to check.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "legendFormat": "read by OCR, per 5 min",
         "expr": "sum(increase(documents_read_total{method=\"ocr\"}[5m]))"},
        {"refId": "B", "legendFormat": "left for a person",
         "expr": "sum(increase(documents_flagged_total[5m]))"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": {
            "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10,
            "showPoints": "never", "spanNulls": true,
            "gradientMode": "opacity", "axisBorderShow": false
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "read by OCR, per 5 min"},
           "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#C9A227"}}]},
          {"matcher": {"id": "byName", "options": "left for a person"},
           "properties": [
             {"id": "color", "value": {"mode": "fixed", "fixedColor": "#D1495B"}},
             {"id": "custom.fillOpacity", "value": 0}
           ]}
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },

    {
      "id": 6,
      "type": "timeseries",
      "title": "6. Rows landing in the tables",
      "description": "What the reader filed, by status, against the running count of rows on file.",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 18},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "legendFormat": "{{status}}",
         "expr": "sum by (status) (increase(documents_by_status_total[5m]))"},
        {"refId": "B", "legendFormat": "documents on file",
         "expr": "max(stored_documents{job=~\"invoice-pipeline|invoice-reader\"})"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": {
            "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 75,
            "stacking": {"mode": "normal", "group": "A"},
            "showPoints": "never", "axisBorderShow": false
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "documents on file"},
           "properties": [
             {"id": "custom.drawStyle", "value": "line"},
             {"id": "custom.lineWidth", "value": 2},
             {"id": "custom.fillOpacity", "value": 0},
             {"id": "custom.stacking", "value": {"mode": "none"}},
             {"id": "custom.axisPlacement", "value": "hidden"},
             {"id": "color", "value": {"mode": "fixed", "fixedColor": "#8E8E93"}}
           ]}
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": []},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    }
  ]
}
