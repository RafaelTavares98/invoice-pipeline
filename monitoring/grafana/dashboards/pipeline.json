      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(stage_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(stage_seconds_sum{stage=\"read\"}[5m])) / sum(rate(invoices_total{stage=\"read\"}[5m]))",
          "legendFormat": "read, per invoice",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
