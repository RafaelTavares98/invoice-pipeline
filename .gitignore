# Everything in Invoices/ is made by running the project and rebuilt in
# minutes, apart from the example invoices at the top of samples/, which
# are committed so a visitor can see what the project produces without
# installing anything.
Invoices/*
!Invoices/samples/
Invoices/samples/*/

# Python leftovers
__pycache__/
*.pyc
.pytest_cache/
.venv/
